{
  "name": "valheim-open-waters",
  "version": "0.1.2",
  "private": true,
  "description": "Development tooling for the Open Waters Valheim mod",
  "scripts": {
    "prepare": "husky",
    "build": "powershell -NoProfile -ExecutionPolicy Bypass -File ./tooling/build-release.ps1 -OutputDir release",
    "build:test": "powershell -NoProfile -ExecutionPolicy Bypass -File ./tooling/build-test.ps1",
    "release": "node tooling/release.mjs",
    "release:dry": "node tooling/release.mjs --dry-run",
    "release:patch": "node tooling/release.mjs patch",
    "release:minor": "node tooling/release.mjs minor",
    "release:major": "node tooling/release.mjs major"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@release-it/conventional-changelog": "^12.0.2",
    "conventional-changelog-conventionalcommits": "^10.4.1",
    "husky": "^9.1.7",
    "release-it": "^21.1.2"
  }
}
